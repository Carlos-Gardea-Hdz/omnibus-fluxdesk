APP_NAME=FluxDesk
APP_ENV=local
APP_KEY=
# APP_DEBUG MUST be false in production (never expose stack traces).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Argon2id is the preferred password hash (security-2026 §6). Laravel's hasher
# is bcrypt by default; switch the driver in config/hashing.php to use argon2id.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL 18 (project law: never MySQL / never SQLite in production) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fluxdesk
DB_USERNAME=fluxdesk
DB_PASSWORD=secret

# --- Sessions: server-side, secure cookies (security-2026 §8) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force-set these to true in staging/production (HTTPS only):
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Valkey 8 (queues + cache). Redis-protocol compatible. ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@fluxdesk.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Flux UI Pro (optional) — license key, NEVER commit a real value ---
FLUX_LICENSE_KEY=

VITE_APP_NAME="${APP_NAME}"

# --- Sail container ports (local dev) ---
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
